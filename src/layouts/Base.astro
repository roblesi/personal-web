---
import '../styles/global.css';

// Google Analytics 4 Measurement ID (property "ignaciorobl.es").
const GA_ID = 'G-MLNRTR35JE';

interface Props {
  title?: string;
  description?: string;
  image?: string; // path to a social share image, relative to the site root
}
const {
  title = 'Ignacio Robles',
  description = 'Ignacio Robles, Staff Software Engineer at Google. AI-native and versatile.',
  image = '/og.jpg',
} = Astro.props;

// Absolute URLs (Astro.site = https://ignaciorobl.es)
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<!--
            _
           (_)            Robles means oaks.
       .-"""""""-.
      /###########\       You found the roots.
      `-._______.-'
       /         \        github.com/roblesi/personal-web
      |           |
       \         /
        `.     .'
          `._.'
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d1712" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ignacio Robles" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Google Analytics (GA4) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      // A note for whoever opens the console.
      console.log(
        '%c🌰 Robles means oaks.\n' +
        '%c15 AI-generated oak styles, one at random per visit. Roll the dice to reshuffle.\n' +
        'Frames, not video: first paint loads one frame, not forty.\n' +
        '%chttps://github.com/roblesi/personal-web',
        'color:#cdbf94;font-weight:600;font-size:13px',
        'color:#9fb39a',
        'color:#cdbf94',
      );

      // Fire a GA4 event for any link tagged with data-ga (resume download, email, etc.).
      document.addEventListener('click', (e) => {
        const t = e.target as Element | null;
        const a = t && t.closest ? t.closest('a[data-ga]') : null;
        if (a) {
          const g = (window as any).gtag;
          if (typeof g === 'function') g('event', a.getAttribute('data-ga'));
        }
      }, true);
    </script>
  </body>
</html>

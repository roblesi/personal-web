---
// The seed / contact. Email comes from the resume data so the two never disagree.
import { resume } from '../data/resume.mjs';
const { email } = resume.contact;
---
<section class="ground" id="contact" aria-label="Contact">
  <div class="contact">
    <div class="eyebrow" style="color:#e6f0d8" aria-hidden="true">The seed</div>
    <h2>Where it all started.</h2>
    <p>One acorn, resting in the grass. Let's talk.</p>
    <div class="row">
      <a href={`mailto:${email}`} data-ga="email_click">{email}</a>
      <a href="https://github.com/roblesi" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/ignaciorobles" target="_blank" rel="noopener">LinkedIn</a>
      <a href="/resume">Resume</a>
    </div>
  </div>
</section>

<script>
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
        const g = (window as any).gtag;
        if (typeof g === 'function') g('event', 'reached_seed');
      }
    }),
    { threshold: 0.25 }
  );
  document.querySelectorAll('.ground').forEach((el) => io.observe(el));
</script>

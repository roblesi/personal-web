---
// The seed / contact. Update the hrefs once the domain email + handles are final.
---
<section class="ground" id="contact" aria-label="Contact">
  <div class="contact">
    <div class="eyebrow" style="color:#e6f0d8" aria-hidden="true">The seed</div>
    <h2>Where it all started.</h2>
    <p>One acorn, resting in the grass. Let's talk.</p>
    <div class="row">
      <a href="mailto:hello@ignaciorobl.es">Email</a>
      <a href="https://github.com/ignaciorobles" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/ignaciorobles" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</section>

<script>
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
    { threshold: 0.25 }
  );
  document.querySelectorAll('.ground').forEach((el) => io.observe(el));
</script>

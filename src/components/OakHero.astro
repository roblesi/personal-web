---
// The oak hero "engine": a fixed canvas that scrubs a random style's frame
// sequence as you scroll (full oak at the top, acorn at the bottom), plus the
// dice easter egg that reshuffles the style. Frames + manifest live in /public/oak.
---

<canvas id="scene" aria-hidden="true"></canvas>
<div class="grain" aria-hidden="true"></div>
<div id="loader" role="status" aria-live="polite">Growing the oak&hellip;</div>

<div id="pull" class="pull" aria-hidden="true">
  <span class="pull-orb">
    <svg class="pull-ring" viewBox="0 0 44 44" width="44" height="44">
      <circle class="pr-track" cx="22" cy="22" r="19"></circle>
      <circle class="pr-fill" cx="22" cy="22" r="19"></circle>
    </svg>
    <svg class="pull-acorn" viewBox="0 0 32 32" width="26" height="26">
      <path class="pa-sprout" d="M16 9 C 15 3 19 1 22 0" fill="none" stroke="#8fbb63" stroke-width="2.4" stroke-linecap="round"></path>
      <ellipse cx="16" cy="19.5" rx="6.4" ry="7.4" fill="#cdbf94"></ellipse>
      <path d="M8.5 12.5h15a1.8 1.8 0 0 1-1.8 3H10.3a1.8 1.8 0 0 1-1.8-3z" fill="#6b4f2a"></path>
      <path d="M9.5 12.5q6.5-4 13 0" fill="none" stroke="#6b4f2a" stroke-width="1.8" stroke-linecap="round"></path>
      <rect x="15.1" y="6.5" width="1.8" height="4" rx="0.9" fill="#6b4f2a"></rect>
    </svg>
  </span>
</div>

<div class="scrollcue" id="cue" aria-hidden="true"><span>Scroll to rewind &darr;</span></div>

<div id="diceWrap" class="dice-wrap">
  <button id="dice" class="dice" title="Roll for a different oak" aria-label="Roll the dice for a different oak style">
    <span class="die" data-v="5"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
    <span class="die" data-v="2"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
  </button>
</div>

<script>
  const reduceMo = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('scene') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const loader = document.getElementById('loader')!;
  const cue = document.getElementById('cue')!;
  const diceWrap = document.getElementById('diceWrap')!;
  const dice = document.getElementById('dice')!;
  const heroCopy = document.getElementById('heroCopy');
  const dieEls = dice.querySelectorAll('.die');

  let DPR = 1, W = 0, H = 0, cur = -1;
  let imgs: HTMLImageElement[] = [], N = 0, ready = false, token = 0;
  let STYLES: { key: string; label: string; frames: number; pframes?: number }[] = [];
  let active: typeof STYLES[number] | null = null;

  // Portrait viewports use the portrait frame set for styles that ship one (pframes).
  const portraitMq = matchMedia('(orientation: portrait)');
  const usePortrait = (s: typeof STYLES[number]) => portraitMq.matches && s.pframes != null;
  const frameCount = (s: typeof STYLES[number]) => (usePortrait(s) ? s.pframes! : s.frames);
  const frameURL = (s: typeof STYLES[number], i: number) =>
    `/oak/${s.key}/${usePortrait(s) ? 'portrait/' : ''}f_${String(i + 1).padStart(3, '0')}.jpg`;

  function resize() {
    DPR = Math.min(devicePixelRatio || 1, 2);
    // Size to the canvas's own CSS box (100% x 100lvh) so the fixed background
    // always covers the largest viewport, even when Safari's toolbar retracts.
    W = canvas.clientWidth || innerWidth; H = canvas.clientHeight || innerHeight;
    canvas.width = W * DPR; canvas.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0); ctx.imageSmoothingQuality = 'high';
    cur = -1; draw();
  }
  function cover(img: HTMLImageElement) {
    const ir = img.naturalWidth / img.naturalHeight, cr = W / H; let w, h;
    if (cr > ir) { w = W; h = W / ir; } else { h = H; w = H * ir; }
    ctx.drawImage(img, (W - w) / 2, (H - h) / 2, w, h);
  }
  function progress() {
    const m = document.documentElement.scrollHeight - innerHeight;
    return m > 0 ? Math.min(1, Math.max(0, scrollY / m)) : 0;
  }
  const frameFor = () => Math.round((N - 1) * (1 - progress())); // top = full oak, bottom = acorn

  function draw() {
    if (ready) {
      const idx = frameFor();
      const im = imgs[idx];
      if (idx !== cur && im && im.complete && im.naturalWidth) { cur = idx; ctx.clearRect(0, 0, W, H); cover(im); }
    }
    const vh = innerHeight, hp = Math.min(scrollY / vh, 1);
    if (heroCopy && !reduceMo) {
      heroCopy.style.transform = `translateY(${hp * -140}px) scale(${1 - hp * 0.06})`;
      heroCopy.style.opacity = `${Math.max(0, 1 - hp * 1.5)}`;
      heroCopy.style.filter = `blur(${hp * 4}px)`;
    }
    cue.style.opacity = `${Math.max(0, 1 - hp * 2.4)}`;
    const df = Math.max(0, Math.min(1, 1 - hp * 1.6));
    diceWrap.style.opacity = `${df}`;
    diceWrap.style.pointerEvents = df < 0.06 ? 'none' : 'auto';
  }

  function loadStyle(style: typeof STYLES[number], showLoader: boolean) {
    active = style; ready = false; cur = -1; const my = ++token;
    N = frameCount(style); imgs = new Array(N); let loaded = 0;
    if (showLoader) loader.classList.remove('done');
    for (let i = 0; i < N; i++) {
      const im = new Image(); im.decoding = 'async';
      im.onload = im.onerror = () => {
        if (my !== token) return; loaded++;
        if (loaded >= N) { ready = true; loader.classList.add('done'); cur = -1; draw(); }
      };
      im.src = frameURL(style, i); imgs[i] = im;
    }
  }
  // Portrait viewports only serve styles that ship a portrait set — a proper
  // vertical oak beats a cropped widescreen, even if that's less variety on phones.
  const eligible = () => {
    const pool = portraitMq.matches ? STYLES.filter(s => s.pframes != null) : STYLES;
    return pool.length ? pool : STYLES;
  };
  function pick(exclude: typeof STYLES[number] | null) {
    let pool = eligible().filter(s => s !== exclude);
    if (!pool.length) pool = eligible();
    return pool[Math.floor(Math.random() * pool.length)];
  }
  function randPips() { dieEls.forEach(d => d.setAttribute('data-v', String(1 + Math.floor(Math.random() * 6)))); }
  function roll() {
    if (!STYLES.length) return;
    const next = pick(active);
    if (!reduceMo) {
      dice.classList.remove('rolling'); void (dice as HTMLElement).offsetWidth; dice.classList.add('rolling');
      randPips(); setTimeout(randPips, 150); setTimeout(randPips, 320);
      setTimeout(() => dice.classList.remove('rolling'), 560);
    } else randPips();
    loadStyle(next, false); // keep the current oak visible until the new one is ready
    const g = (window as any).gtag;
    if (typeof g === 'function') g('event', 'oak_reroll', { oak_style: next.key });
  }

  dice.addEventListener('click', roll);
  randPips();

  // --- pull-to-refresh easter egg: pull down from the very top to grow a fresh oak ---
  const pull = document.getElementById('pull')!;
  const orb = pull.querySelector('.pull-orb') as HTMLElement;
  const acornEl = pull.querySelector('.pull-acorn') as SVGElement;
  const ringFill = pull.querySelector('.pr-fill') as SVGElement;
  const RING_C = 119.4;               // 2πr, r = 19
  const P_MAX = 220, P_TRIGGER = 122; // longer pull than v1
  let pStart = 0, pOn = false, pDist = 0;
  const clearP = () => {
    pull.classList.remove('ready', 'fired');
    orb.style.transition = acornEl.style.transition = ringFill.style.transition = pull.style.transition = '';
    orb.style.transform = 'translateY(0)';
    acornEl.style.transform = 'rotate(0) scale(.8)';
    ringFill.style.strokeDashoffset = String(RING_C);
    pull.style.opacity = '0';
  };
  const setP = (d: number) => {
    pDist = d;
    const prog = Math.min(1, d / P_TRIGGER);
    pull.style.opacity = String(Math.min(1, d / 42));
    orb.style.transform = `translateY(${Math.min(d * 0.5, 104)}px)`;
    acornEl.style.transform = `rotate(${d * 2.1}deg) scale(${0.8 + prog * 0.2})`;
    ringFill.style.strokeDashoffset = String(RING_C * (1 - prog));
    pull.classList.toggle('ready', prog >= 1);
  };
  const springBack = () => {
    orb.style.transition = acornEl.style.transition = 'transform .45s cubic-bezier(.34,1.56,.64,1)';
    ringFill.style.transition = 'stroke-dashoffset .35s ease';
    pull.style.transition = 'opacity .4s ease';
    orb.style.transform = 'translateY(0)';
    acornEl.style.transform = 'rotate(0) scale(.8)';
    ringFill.style.strokeDashoffset = String(RING_C);
    pull.style.opacity = '0';
    setTimeout(clearP, 470);
  };
  const fire = () => {
    const y = Math.min(pDist * 0.5, 104);
    // Beat 1: land it — ring completes, acorn pops upright, the shoot sprouts.
    orb.style.transition = 'transform .5s cubic-bezier(.34,1.56,.64,1)';
    acornEl.style.transition = 'transform .5s cubic-bezier(.34,1.56,.64,1)';
    ringFill.style.transition = 'stroke-dashoffset .28s ease';
    ringFill.style.strokeDashoffset = '0';
    orb.style.transform = `translateY(${y}px) scale(1.12)`;
    acornEl.style.transform = 'rotate(0) scale(1.05)';
    pull.classList.add('fired');                                  // grows the sprout (CSS)
    roll();                                                       // grow a new oak
    const g = (window as any).gtag;
    if (typeof g === 'function') g('event', 'pull_refresh');      // measure easter-egg usage
    // Beat 2: hold so the sprout is readable, then float up and fade out.
    setTimeout(() => {
      orb.style.transition = 'transform .6s ease, opacity .6s ease';
      pull.style.transition = 'opacity .6s ease';
      orb.style.transform = `translateY(${y - 16}px) scale(.9)`;
      pull.style.opacity = '0';
    }, 680);
    setTimeout(clearP, 1340);
  };
  const onMove = (e: TouchEvent) => {
    const dy = e.touches[0].clientY - pStart;
    if (dy <= 0 || scrollY > 0) { endP(false); return; }
    e.preventDefault(); // we own the gesture; blocks the native pull-to-refresh
    setP(Math.min(dy, P_MAX));
  };
  const endP = (release: boolean) => {
    if (!pOn) return;
    pOn = false;
    removeEventListener('touchmove', onMove);
    if (release && pDist >= P_TRIGGER) fire();
    else if (pDist > 0) springBack();
    else pull.style.opacity = '0';
  };
  addEventListener('touchstart', (e) => {
    if (scrollY <= 0 && e.touches.length === 1) {
      orb.style.transition = acornEl.style.transition = ringFill.style.transition = pull.style.transition = '';
      pStart = e.touches[0].clientY; pOn = true; pDist = 0;
      addEventListener('touchmove', onMove, { passive: false });
    }
  }, { passive: true });
  addEventListener('touchend', () => endP(true), { passive: true });
  addEventListener('touchcancel', () => endP(false), { passive: true });

  let ticking = false;
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { draw(); ticking = false; }); } }, { passive: true });
  addEventListener('resize', resize);
  // Keep the drawing buffer matched to the canvas's actual box. iOS Safari settles
  // 100lvh a beat after first paint; without this the oak stretches on first load.
  if (typeof ResizeObserver !== 'undefined') new ResizeObserver(() => resize()).observe(canvas);
  resize();
  // On rotate: entering portrait with a widescreen-only style, pick one that has a
  // portrait set; otherwise swap the active style between its two frame sets.
  portraitMq.addEventListener('change', () => {
    if (!active) return;
    if (portraitMq.matches && active.pframes == null) loadStyle(pick(active), false);
    else if (active.pframes != null) loadStyle(active, false);
  });

  fetch('/oak/manifest.json')
    .then(r => r.json())
    .then((m: { styles: typeof STYLES }) => { STYLES = m.styles || []; if (STYLES.length) loadStyle(pick(null), true); })
    .catch(() => { loader.textContent = 'the oak'; loader.classList.add('done'); });
</script>

---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { resume as r } from '../data/resume.mjs';

// Structured data: this page is Ignacio's professional profile (ProfilePage),
// with the Person as its main entity. Helps Google understand the entity and
// tie together the site, GitHub, and LinkedIn.
const profileLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: r.name,
    jobTitle: 'Staff Software Engineer',
    worksFor: { '@type': 'Organization', name: 'Google' },
    url: 'https://ignaciorobl.es',
    email: `mailto:${r.contact.email}`,
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Granada' },
    knowsAbout: [
      'Large language models', 'Generative AI', 'Applied machine learning',
      'Distributed systems', 'AI-native development', 'System design',
    ],
    sameAs: ['https://github.com/roblesi', 'https://www.linkedin.com/in/ignaciorobles'],
  },
};
---

<Base
  title="Resume · Ignacio Robles"
  description="Resume of Ignacio Robles, Staff Software Engineer at Google. AI-native and versatile.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(profileLd)} />
  <Nav />
  <main class="page resume" id="main">
    <div class="eyebrow">Resume</div>
    <h1>{r.name}</h1>
    <p class="lede">{r.tagline}</p>

    <div class="cta">
      <a class="dl" href="/resume.pdf" download data-ga="resume_download">Download PDF</a>
      <span class="contactline">
        {r.location} ·
        <a href={`mailto:${r.contact.email}`}>{r.contact.email}</a> ·
        <a href="https://github.com/roblesi">{r.contact.github}</a> ·
        <a href="https://www.linkedin.com/in/ignaciorobles">LinkedIn</a>
      </span>
    </div>

    <h2>Summary</h2>
    <p class="body">{r.summary}</p>

    <h2>Skills</h2>
    <dl class="skills">
      {r.skills.map((s) => (
        <div class="skill">
          <dt>{s.label}</dt>
          <dd>{s.items}</dd>
        </div>
      ))}
    </dl>

    <h2>Experience</h2>
    <div class="exp">
      {r.experience.map((job) => (
        <article class="role">
          <div class="role-head">
            <h3>{job.title}, <span class="org">{job.org}</span></h3>
            <span class="dates">{job.dates}</span>
          </div>
          <div class="loc">{job.location}</div>
          <ul>
            {job.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <h2>Patents</h2>
    <p class="body">{r.patents.lead} <i>{r.patents.title}</i> {r.patents.tail}</p>

    <h2>Publications</h2>
    <ul class="reflist">
      {r.publications.map((p) => (
        <li>
          <span class="t">{p.cite} <i>{p.title}</i></span>
          <span class="m">{p.venue}</span>
        </li>
      ))}
    </ul>

    <h2>Education</h2>
    <ul class="reflist">
      {r.education.map((e) => (
        <li>
          <span class="t">{e.degree}</span>
          <span class="m">{e.meta}</span>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  /* Download button + contact line */
  .cta{display:flex;flex-wrap:wrap;align-items:center;gap:14px 20px;margin-top:26px}
  .dl{display:inline-block;background:var(--gold);color:#14231b;font-size:12px;font-weight:500;
    letter-spacing:.12em;text-transform:uppercase;text-decoration:none;padding:11px 20px;border-radius:10px;
    transition:transform .15s ease,box-shadow .2s ease}
  .dl:hover{transform:translateY(-1px);box-shadow:0 10px 24px -12px rgba(205,191,148,.6)}
  .contactline{color:var(--cream-dim);font-size:13px;letter-spacing:.02em}
  .contactline a{color:var(--cream-dim);text-decoration:none;border-bottom:1px solid rgba(205,191,148,.35);padding-bottom:1px}
  .contactline a:hover{color:var(--cream)}

  .resume .body{color:var(--cream-dim);line-height:1.65;margin-top:6px;max-width:70ch}

  /* Skills */
  .skills{margin:0;border-top:1px solid var(--line)}
  .skills .skill{display:grid;grid-template-columns:190px 1fr;gap:6px 22px;padding:14px 0;border-bottom:1px solid var(--line)}
  .skills dt{color:var(--gold);font-size:13px;letter-spacing:.03em}
  .skills dd{color:var(--cream-dim);font-size:14.5px;line-height:1.55;margin:0}
  @media (max-width:560px){.skills .skill{grid-template-columns:1fr;gap:4px}}

  /* Experience */
  .exp{display:flex;flex-direction:column}
  .role{padding:18px 0;border-bottom:1px solid var(--line)}
  .role:first-child{border-top:1px solid var(--line)}
  .role-head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap}
  .role h3{font-weight:400;font-size:17px;letter-spacing:-.01em;color:var(--cream)}
  .role h3 .org{color:var(--gold)}
  .role .dates{color:var(--cream-dim);font-size:12.5px;letter-spacing:.04em;white-space:nowrap;font-variant-numeric:tabular-nums}
  .role .loc{color:var(--cream-dim);font-size:12.5px;opacity:.8;margin-top:2px}
  .role ul{list-style:none;padding:0;margin:10px 0 0}
  .role li{position:relative;padding-left:16px;color:var(--cream-dim);font-size:14.5px;line-height:1.55;margin-bottom:5px}
  .role li::before{content:"";position:absolute;left:2px;top:9px;width:4px;height:4px;border-radius:50%;background:var(--gold);opacity:.7}

  .reflist .t i,.resume .body i{font-style:italic}
</style>
